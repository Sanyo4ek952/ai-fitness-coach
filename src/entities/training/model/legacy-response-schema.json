{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "coach_response"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "context": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "profileRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "programVersionId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "historyRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "profileRevision",
            "programVersionId",
            "historyRevision"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "reasons": {
          "readOnly": true,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "nutritionTips": {
          "readOnly": true,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        },
        "decision": {
          "type": "string",
          "const": "propose_program"
        },
        "proposedProgram": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "goalInterpretation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "workouts": {
              "readOnly": true,
              "minItems": 1,
              "maxItems": 14,
              "type": "array",
              "items": {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "exercises": {
                    "readOnly": true,
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "readOnly": true,
                      "type": "object",
                      "properties": {
                        "exerciseId": {
                          "type": "string",
                          "maxLength": 80,
                          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                        },
                        "sets": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 20
                        },
                        "target": {
                          "readOnly": true,
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "reps"
                                },
                                "min": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 100
                                },
                                "max": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 100
                                },
                                "weightKg": {
                                  "anyOf": [
                                    {
                                      "type": "number",
                                      "minimum": 0,
                                      "maximum": 1000
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "type",
                                "min",
                                "max",
                                "weightKg"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "duration"
                                },
                                "seconds": {
                                  "type": "number",
                                  "minimum": 1,
                                  "maximum": 7200
                                },
                                "intensity": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 240
                                }
                              },
                              "required": [
                                "type",
                                "seconds"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "distance"
                                },
                                "meters": {
                                  "type": "number",
                                  "minimum": 1,
                                  "maximum": 100000
                                },
                                "intensity": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 240
                                }
                              },
                              "required": [
                                "type",
                                "meters"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "restSec": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 600
                        },
                        "rir": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 10
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "note": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 240
                        }
                      },
                      "required": [
                        "exerciseId",
                        "sets",
                        "target",
                        "restSec"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "title",
                  "exercises"
                ],
                "additionalProperties": false
              }
            },
            "reviewAfterSessions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 14
            }
          },
          "required": [
            "title",
            "goalInterpretation",
            "workouts",
            "reviewAfterSessions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "context",
        "summary",
        "reasons",
        "nutritionTips",
        "decision",
        "proposedProgram"
      ],
      "additionalProperties": false
    },
